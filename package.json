{
  "name": "mulqi-getfable",
  "version": "1.0.0",
  "description": "Mulqi GetFable — a portable coding-lifecycle discipline for DeepSeek Harness: deterministic routing across 17 lifecycle skills, durable .fable state machine, mutation-aware verification, a bounded doctor, and a DSH-native web dashboard.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "skills/",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "agent-skills",
    "coding-lifecycle",
    "tdd",
    "verification",
    "deterministic-routing",
    "ai-agent"
  ],
  "license": "MIT",
  "author": "Mulqizamzam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mulqizamzam/mulqi-getfable.git"
  },
  "homepage": "https://github.com/mulqizamzam/mulqi-getfable#readme",
  "bugs": {
    "url": "https://github.com/mulqizamzam/mulqi-getfable/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "build:skills": "node scripts/generate-skills.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "node scripts/validate-bundle.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "react": "^18.2.0",
    "tsdown": "^0.22.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
